[gd_resource type="Resource" script_class="TutorialSteps" format=3 uid="uid://cojuob2qi5e6g"]

[ext_resource type="Script" uid="uid://c8gqg50ji0tsl" path="res://lesson/tutorial/scripts/tutorial_step.gd" id="1_step"]
[ext_resource type="Script" uid="uid://c6yayqqudxs3d" path="res://lesson/tutorial/scripts/tutorial_steps.gd" id="2_steps"]

[sub_resource type="Resource" id="Step_1"]
script = ExtResource("1_step")
title = "1. 複製一隻範例生物"
description = "從 example/creatures 挑一隻喜歡的範例生物，複製到 my_creature 資料夾，取一個自己的檔名。"
hint = "在左下角的檔案系統（FileSystem）對範例按右鍵 → 複製（Duplicate），檔名改成自己的（例如 my_snake.tscn）。
複製完把檔案拖進 my_creature 資料夾。或是打開範例後，用「場景 → 另存場景為」（Scene → Save Scene As）存到 my_creature。"

[sub_resource type="Resource" id="Step_2"]
script = ExtResource("1_step")
title = "2. 改身體"
description = "改身體（Body 節點，ChainBody）的屬性，至少跟範例有 2 項不一樣：節數、粗細、身體顏色、花紋……"
hint = "打開你的生物，點 Body 節點，在右邊的檢查器（Inspector）改。不用執行就看得到樣子。
身體顏色（Body Gradient）點開可以加顏色變漸層；粗細曲線（Width Curve）可以拉出頭大尾巴細的形狀。"

[sub_resource type="Resource" id="Step_3"]
script = ExtResource("1_step")
title = "3. 加一對腳"
description = "幫生物加一對腳（IKLeg）。範例本來就有腳的話，改一個腳的屬性也算（例如腳長、跨步距離）。"
hint = "對 Body 節點按右鍵 → 加入子節點（Add Child Node），搜尋 IKLeg。左右（Side）選「兩邊」一個節點就是一對。
掛在第幾節（Attach Segment）決定腳長在哪；兩對以上時，分組（Group）A、B 交錯，走起來才自然。"

[sub_resource type="Resource" id="Step_4"]
script = ExtResource("1_step")
title = "4. 加觸手或尾巴"
description = "幫生物加觸手、尾巴或鬍鬚（Tentacle）。範例本來就有的話，改一個觸手的屬性也算。"
hint = "對 Body 按右鍵 → 加入子節點，搜尋 Tentacle。掛在第 -1 節、伸出角度 180 就是尾巴；掛在第 0 節、角度小一點就是觸角。
行為（Behavior）可以試試「波浪擺動」「指向滑鼠」。"

[sub_resource type="Resource" id="Step_5"]
script = ExtResource("1_step")
title = "5. 做自己的池塘"
description = "把範例池塘複製到 my_creature，玩家生物換成你的生物，再改至少一條遊戲規則。"
hint = "對 example/pond/pond.tscn 按右鍵 → 複製，存到 my_creature。打開它，點最上層的 Pond 節點：
把你的生物從檔案系統拖進 Player Creature，再改一條規則（例如 Predator Count 天敵數量、Food Flees 食物會逃跑）。可以參考抽到的規則卡。"

[sub_resource type="Resource" id="Step_6"]
script = ExtResource("1_step")
title = "6. 接上標題、玩到結算"
description = "讓標題畫面的「開始遊戲」進到你的池塘，然後在教學關按「試玩」，玩到贏或輸。"
hint = "打開 game/title_screen/title_screen.tscn，點 TitleScreen 節點，把你的池塘拖進 Pond Scene，按 Ctrl+S 存檔。
回到教學關按「檢查」，上面的試玩就會變成你的池塘，按「試玩」玩到出現結算畫面。標題畫面的 GameName 也記得改成你的遊戲名稱。"

[sub_resource type="Resource" id="Step_7"]
script = ExtResource("1_step")
title = "額外：自己的天敵"
description = "再做一隻生物當天敵，放進池塘的天敵生物。"
hint = "再複製一隻範例（例如 predator_eel）到 my_creature 改一改，拖進池塘的 Predator Creature。
天敵不管原本的控制方式，都會被改成「追玩家」。想要「天敵就是你自己的生物」，直接拖你的玩家生物也可以。"

[sub_resource type="Resource" id="Step_8"]
script = ExtResource("1_step")
title = "額外：觸手抓食物"
description = "讓生物有一條觸手會自己伸去抓最近的食物。"
hint = "點一個 Tentacle 節點，把 Behavior 改成「抓最近的食物」。食物在觸手長度（Length）以內就會伸過去，碰到就吃掉。
觸手太短抓不到的話，把長度調大。"

[sub_resource type="Resource" id="Step_9"]
script = ExtResource("1_step")
title = "額外：寫一點程式"
description = "在生物底下加一個節點、掛上自己的腳本，接上 grew 訊號，讓生物長大時做點什麼。"
hint = "參考 example/grow_challenge（每長 5 節換一次顏色）。對生物最上層的節點按右鍵 → 加入子節點（Node），再按右鍵 → 附加腳本（Attach Script）。
點生物最上層的節點 → 右邊切到「節點」（Node）分頁 → 雙擊 grew(level) → 選剛剛的節點 → 連接（Connect）。"

[sub_resource type="Resource" id="Step_10"]
script = ExtResource("1_step")
title = "額外：加一個掛件"
description = "幫生物加一個掛件（Ornament）：換一個內建形狀，或在底下放自己畫的圖。"
hint = "對 Body 按右鍵 → 加入子節點，搜尋 Ornament，形狀（Shape）選翅膀、魚鰭、星星……；左右選「兩邊」就是一對。
想放自己畫的圖：形狀選「無」，在 Ornament 底下加一個 Sprite2D，把 PNG 拖進 Texture。圖的根部放在原點、往右是往外伸的方向。"

[resource]
script = ExtResource("2_steps")
steps = Array[ExtResource("1_step")]([SubResource("Step_1"), SubResource("Step_2"), SubResource("Step_3"), SubResource("Step_4"), SubResource("Step_5"), SubResource("Step_6"), SubResource("Step_7"), SubResource("Step_8"), SubResource("Step_9"), SubResource("Step_10")])
