[gd_resource type="Resource" script_class="CardDeck" format=3]

[ext_resource type="Script" path="res://lesson/card_draw/scripts/card_deck.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
bodies = "蛇
蜈蚣
章魚
蜘蛛
水母
長了四隻腳的蛇（蜥蜴）
龍（長身體＋四隻腳＋鬍鬚）
毛毛蟲
蝌蚪
蠍子（尾巴往前彎）
烏賊
機械蛇
拖著觸手的眼球
長了一堆腳的魚
外星觸手怪"
habitats = "池塘
岩漿
下水道
外太空
深海
糖果池
墨水瓶裡
結冰的湖
電路板
湯碗裡
浴缸
培養皿
雲上面
水族箱
深夜的水溝"
rules = "沒有腳，只靠游動
只能有一顆眼睛
至少 8 隻腳
觸手比身體還長
全身只用兩種顏色
至少 3 個會動的掛件
身體 10 節以內
在生態缸撞倒 3 隻
在生態缸長到 10 級
一次都不加速，長到 5 級
★ 每升 5 級換一個顏色（接 grew 訊號）
★ 升級的時候眼睛變大一點
★ 越長大，翅膀拍得越快
★ 升到 10 級長出一對角
★ 升級的時候身體閃一下"
