[gd_resource type="Resource" script_class="CardDeck" format=3]

[ext_resource type="Script" path="res://lesson/card_draw/scripts/card_deck.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
bodies = "蛇
蜈蚣
章魚
蜘蛛
水母
長了四隻腳的蛇（蜥蜴）
龍（長身體＋四隻腳＋鬍鬚）
毛毛蟲
蝌蚪
蠍子（尾巴往前彎）
烏賊
機械蛇
拖著觸手的眼球
長了一堆腳的魚
外星觸手怪"
personalities = "很膽小，眼睛一直盯著別人
走路搖搖晃晃，像喝醉了
很優雅，慢慢地扭來扭去
很神經質，腳步又快又碎
愛炫耀，翅膀一直拍
很貪吃，觸手一直往飼料伸
懶洋洋，拖著長長的尾巴
很兇，到處亂衝
好奇寶寶，一直東張西望
很僵硬，像機器人一樣
軟趴趴，像果凍一樣
很害羞，常常眨眼睛
很驕傲，頭上頂著大大的角
剛睡醒，動作慢吞吞
很開心，全身都在搖擺"
playstyles = "衝刺型：全場最快，但轉不太動
擋路專家：身體超長，讓別人撞上來
採集者：觸手抓飼料，不用頭也能吃
千里眼：看得最遠，早一步發現危險
靈活型：轉彎最快，在縫隙裡鑽來鑽去
坦克：塊頭最大，但跑不快
小不點：越小越好，到處偷吃
長大狂：升級最快的長大方式
平衡型：每種能力都差不多
偷襲者：又快又小，衝到別人前面擋路
蜈蚣大軍：腳越多越好
觸手怪：至少四條觸手
越長越多腳：長大時一直長出新的腳
眼睛怪：眼睛越多越好
不靠腳：完全靠扭動身體前進"
